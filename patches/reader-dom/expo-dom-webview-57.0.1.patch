+// SPDX-License-Identifier: BSD-3-Clause
+package expo.modules.webview
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class ReaderDomPolicyTest {
+  private val hash = "0123456789abcdef0123456789abcdef"
+  private val packaged = "file:///android_asset/www.bundle/$hash.html"
+  private val canonical = "${ReaderDomPolicy.ORIGIN}/www.bundle/$hash.html"
+  private fun configured() = ReaderDomPolicy(false, null).apply { setEntry(packaged) }
+  private fun rejects(block: () -> Unit) {
+    try { block(); fail("Expected fail-closed rejection") } catch (_: IllegalArgumentException) { }
+  }
+
+  @Test fun canonicalOriginSurvivesNewHostAndBundleHash() {
+    assertEquals(canonical, configured().entry.toString())
+    val other = ReaderDomPolicy(false, null).setEntry(packaged.replace(hash, "f".repeat(32)))
+    assertEquals(ReaderDomPolicy.ORIGIN, ReaderDomPolicy.origin(ReaderDomPolicy.parse(other)!!))
+    assertTrue(configured().isEntry("$canonical#cfi"))
+    assertFalse(configured().isEntry("$canonical?unexpected=1"))
+  }
+
+  @Test fun productionRejectsDevelopmentOverridesEvenForPackagedSource() {
+    rejects { ReaderDomPolicy(false, "http://localhost:8081") }
+    for (source in listOf("https://manabi.io/reader.html", "http://localhost:8081/_expo/@dom?file=x",
+      canonical, "file:///data/data/io.manabi.reader/a.html", "file:///android_asset/secrets.html")) {
+      rejects { ReaderDomPolicy(false, null).setEntry(source) }
+    }
+  }
+
+  @Test fun onlyExplicitDebugMetroOriginCanSupplyDevelopmentRoot() {
+    val policy = ReaderDomPolicy(true, "http://localhost:8081")
+    val source = "http://localhost:8081/_expo/@dom/reader?file=file%3A%2F%2F%2Fapp%2Freader.tsx"
+    assertEquals(source, policy.setEntry(source))
+    for (origin in listOf("*", "https://user:secret@localhost:8081", "https://localhost:8081/path",
+      "https://appassets.androidplatform.net", "https://localhost:8081?x=1")) rejects { ReaderDomPolicy(true, origin) }
+    for (source in listOf("http://localhost:8082/_expo/@dom", "http://evil.test/_expo/@dom", "http://localhost:8081/other")) {
+      rejects { ReaderDomPolicy(true, "http://localhost:8081").setEntry(source) }
+    }
+    rejects { ReaderDomPolicy(true, null).setEntry(source) }
+  }
+
+  @Test fun apkMappingPreservesPublicWorkerWasmAndCorrespondingSourcePaths() {
+    val policy = configured()
+    for (asset in listOf("_expo/static/js/web/worker-0123.js", "manabitan/revision/worker.mjs",
+      "manabitan/revision/sqlite.wasm", "manabitan/revision/corresponding-source.tar.gz", "icons/icon.svg")) {
+      assertEquals(asset, policy.assetPath("${ReaderDomPolicy.ORIGIN}/www.bundle/$asset"))
+    }
+  }
+
+  @Test fun traversalAndEncodedEscapesAreRejected() {
+    val policy = configured()
+    for (path in listOf("../secret", "%2e%2e/secret", "%2E%2E%2Fsecret", "%252e%252e/secret",
+      "foo%2f..%2fsecret", "foo%5csecret", "foo%00secret", "/secret", "foo/./bar", "foo//bar")) {
+      assertNull(path, policy.assetPath("${ReaderDomPolicy.ORIGIN}/www.bundle/$path"))
+    }
+    for (url in listOf("${ReaderDomPolicy.ORIGIN}/other/a.js", "https://evil.test/www.bundle/a.js",
+      "https://user:secret@appassets.androidplatform.net/www.bundle/a.js",
+      "file:///android_asset/www.bundle/a.js")) assertNull(policy.assetPath(url))
+  }
+
+  @Test fun invalidReservedHostVariantsNeverFallThroughToNetwork() {
+    val policy = configured()
+    for (url in listOf(canonical, "http://appassets.androidplatform.net/a", "https://appassets.androidplatform.net:444/a",
+      "https://user:secret@appassets.androidplatform.net/a", "https://appassets.androidplatform.net./a")) assertTrue(policy.isAssetHost(url))
+    assertFalse(policy.isAssetHost("https://appassets.androidplatform.net.evil.test/a"))
+  }
+
+  @Test fun messagesRequireExactOriginMainFrameAndTrustedRoot() {
+    val policy = configured()
+    assertTrue(policy.acceptsMessage(ReaderDomPolicy.ORIGIN, true, canonical))
+    assertFalse(policy.acceptsMessage(ReaderDomPolicy.ORIGIN, false, canonical))
+    assertFalse(policy.acceptsMessage("https://evil.test", true, canonical))
+    assertFalse(policy.acceptsMessage("null", true, canonical))
+    assertFalse(policy.acceptsMessage(ReaderDomPolicy.ORIGIN, true, "${ReaderDomPolicy.ORIGIN}/www.bundle/other.html"))
+    assertFalse(policy.acceptsMessage(ReaderDomPolicy.ORIGIN, true, "https://evil.test"))
+  }
+
+  @Test fun navigationAndRootReplacementFailClosed() {
+    val policy = configured()
+    for (url in listOf("https://evil.test", "javascript:alert(1)", "data:text/html,x", "file:///etc/passwd",
+      "${ReaderDomPolicy.ORIGIN}/www.bundle/other.html")) assertFalse(policy.isEntry(url))
+    rejects { policy.setEntry(packaged.replace(hash, "f".repeat(32))) }
+    assertTrue(policy.isExternal("https://example.com/a"))
+    assertTrue(policy.isExternal("http://example.com/a"))
+    for (url in listOf("https://user:secret@example.com", "https://@example.com", "javascript:alert(1)",
+      "file:///etc/passwd", "intent://example.com", canonical)) assertFalse(policy.isExternal(url))
+  }
+}
