new file mode 100644
index 0000000..bb357db
--- /dev/null
+++ b/android/src/main/java/expo/modules/webview/ReaderDomHost.kt
@@ -0,0 +1,158 @@
+// Manabi Reader secure Android DOM adapter. SPDX-License-Identifier: BSD-3-Clause
+package expo.modules.webview
+
+import android.content.Context
+import android.content.pm.ApplicationInfo
+import android.webkit.WebResourceRequest
+import android.webkit.WebResourceResponse
+import android.webkit.WebSettings
+import android.webkit.WebView
+import androidx.webkit.ScriptHandler
+import androidx.webkit.WebMessageCompat
+import androidx.webkit.WebViewAssetLoader
+import androidx.webkit.WebViewCompat
+import androidx.webkit.WebViewFeature
+import java.io.ByteArrayInputStream
+import java.io.IOException
+import java.net.URLConnection
+import org.json.JSONObject
+
+/** Opt-in only. Keeps Expo's DOM protocol but gives it an origin- and frame-checked transport. */
+internal class ReaderDomHost(
+  private val context: Context,
+  private val webView: WebView,
+  private val onMessage: (String) -> Unit,
+  private val onExternalLink: (String) -> Unit
+) {
+  private var policy: ReaderDomPolicy? = null
+  private var script: ScriptHandler? = null
+  private var started = false
+  private var devOrigin: String? = null
+  private val debuggable = context.applicationInfo.flags and ApplicationInfo.FLAG_DEBUGGABLE != 0
+  private val assetLoader = WebViewAssetLoader.Builder()
+    .setDomain("appassets.androidplatform.net")
+    .setHttpAllowed(false)
+    .addPathHandler(ReaderDomPolicy.ASSET_PREFIX, WebViewAssetLoader.PathHandler { path ->
+      // AssetLoader passes a decoded suffix. The request-level policy separately rejects encoded traversal.
+      try {
+        val stream = context.assets.open("www.bundle/$path")
+        val mime = when (path.substringAfterLast('.', "").lowercase()) {
+          "js", "mjs" -> "text/javascript"
+          "wasm" -> "application/wasm"
+          "json", "map" -> "application/json"
+          "css" -> "text/css"
+          "html", "htm" -> "text/html"
+          "svg" -> "image/svg+xml"
+          "woff" -> "font/woff"
+          "woff2" -> "font/woff2"
+          else -> URLConnection.guessContentTypeFromName(path) ?: "application/octet-stream"
+        }
+        WebResourceResponse(mime, null, 200, "OK", mapOf(
+          "X-Content-Type-Options" to "nosniff",
+          "Cache-Control" to "no-cache"
+        ), stream)
+      } catch (_: IOException) { errorResponse(404, "Not Found") }
+    }).build()
+
+  @Suppress("DEPRECATION")
+  fun prepare(source: String, configuredDevOrigin: String?, injectedObject: String): String {
+    if (policy == null) {
+      policy = ReaderDomPolicy(debuggable, configuredDevOrigin)
+      devOrigin = configuredDevOrigin
+    }
+    require(configuredDevOrigin == devOrigin) { "A reader host cannot change its development origin." }
+    val currentPolicy = checkNotNull(policy)
+    val resolved = currentPolicy.setEntry(source)
+    if (started) return resolved
+    // No unscoped Java interface is left accessible to an EPUB iframe, blob, or third-party document.
+    webView.removeJavascriptInterface("ReactNativeWebView")
+    webView.removeJavascriptInterface("ExpoDomWebViewBridge")
+    webView.settings.apply {
+      allowFileAccess = false
+      allowContentAccess = false
+      allowFileAccessFromFileURLs = false
+      allowUniversalAccessFromFileURLs = false
+      mixedContentMode = WebSettings.MIXED_CONTENT_NEVER_ALLOW
+      domStorageEnabled = true
+      javaScriptCanOpenWindowsAutomatically = false
+      setSupportMultipleWindows(false)
+    }
+    if (!debuggable) WebView.setWebContentsDebuggingEnabled(false)
+    check(WebViewFeature.isFeatureSupported(WebViewFeature.WEB_MESSAGE_LISTENER) &&
+      WebViewFeature.isFeatureSupported(WebViewFeature.DOCUMENT_START_SCRIPT)) {
+      "Update Android System WebView before opening the offline reader."
+    }
+    val allowedOrigins = setOf(checkNotNull(ReaderDomPolicy.origin(checkNotNull(currentPolicy.entry))))
+    WebViewCompat.addWebMessageListener(webView, "ManabiReaderPort", allowedOrigins) {
+        view, message, sourceOrigin, isMainFrame, _ ->
+      if (message.type == WebMessageCompat.TYPE_STRING &&
+        currentPolicy.acceptsMessage(sourceOrigin.toString(), isMainFrame, view.url)) {
+        val data = message.data
+        if (data != null && data.length <= 1_048_576) onMessage(data)
+      }
+    }
+    val entry = checkNotNull(currentPolicy.entry)
+    val bootstrap = """
+      (() => {
+        if (window.top !== window || location.pathname !== ${JSONObject.quote(entry.rawPath)} ||
+            location.search !== ${JSONObject.quote(entry.rawQuery?.let { "?$it" } ?: "")}) return;
+        const port = window.ManabiReaderPort;
+        const initial = ${JSONObject.quote(injectedObject)};
+        Object.defineProperty(window, 'ReactNativeWebView', { configurable: false, writable: false,
+          value: Object.freeze({
+            postMessage: message => { if (typeof message === 'string' && message.length <= 1048576) port.postMessage(message); },
+            injectedObjectJson: () => initial
+          })
+        });
+      })();
+    """.trimIndent()
+    script = WebViewCompat.addDocumentStartJavaScript(webView, bootstrap, allowedOrigins)
+    started = true
+    return resolved
+  }
+
+  fun isTrustedPage(value: String?): Boolean = started && policy?.isEntry(value) == true
+
+  fun shouldOverride(request: WebResourceRequest): Boolean {
+    val current = policy ?: return true
+    val url = request.url.toString()
+    if (request.isForMainFrame && current.isEntry(url)) return false
+    // Do not navigate even for valid external links. The native parent validates and opens a browser.
+    if (request.isForMainFrame && request.hasGesture() && request.method == "GET" && current.isExternal(url)) {
+      onExternalLink(url)
+    }
+    // Frame loads are limited to local packaged content. EPUB's scriptless blob/srcdoc frames
+    // are renderer-owned and are not delegated to a network or file URL.
+    if (request.isForMainFrame) return true
+    return current.assetPath(url) == null && request.url.scheme !in setOf("blob", "data", "about")
+  }
+
+  fun intercept(request: WebResourceRequest): WebResourceResponse? {
+    val current = policy ?: return errorResponse(403, "Forbidden")
+    val url = request.url.toString()
+    if (request.isForMainFrame && !current.isEntry(url)) return errorResponse(403, "Forbidden")
+    if (current.isAssetHost(url) || request.url.host?.trimEnd('.')?.equals("appassets.androidplatform.net", ignoreCase = true) == true) {
+      if (!current.isAssetOrigin(url) || request.method != "GET" || current.assetPath(url) == null) return errorResponse(404, "Not Found")
+      // Missing APK files must never fall through to DNS/network, including module workers and WASM.
+      return assetLoader.shouldInterceptRequest(request.url) ?: errorResponse(404, "Not Found")
+    }
+    if (request.url.scheme !in setOf("https", "http", "blob", "data")) return errorResponse(403, "Forbidden")
+    // Existing browser fetch/CORS rules govern app API traffic; there is no native network proxy.
+    return null
+  }
+
+  fun destroy() {
+    script?.remove()
+    if (started) WebViewCompat.removeWebMessageListener(webView, "ManabiReaderPort")
+    started = false
+  }
+
+  companion object {
+    fun blockedResponse(): WebResourceResponse = errorResponse(403, "Forbidden")
+
+    private fun errorResponse(status: Int, reason: String) = WebResourceResponse(
+      "text/plain", "UTF-8", status, reason, mapOf("Cache-Control" to "no-store"),
+      ByteArrayInputStream(reason.toByteArray(Charsets.UTF_8))
+    )
+  }
+}
diff --git a/android/src/main/java/expo/modules/webview/ReaderDomPolicy.java b/android/src/main/java/expo/modules/webview/ReaderDomPolicy.java
new file mode 100644
index 0000000..60486bd
--- /dev/null
+++ b/android/src/main/java/expo/modules/webview/ReaderDomPolicy.java
@@ -0,0 +1,122 @@
+// Manabi Reader secure-host policy. SPDX-License-Identifier: BSD-3-Clause
+package expo.modules.webview;
+
+import java.net.URI;
+import java.net.URISyntaxException;
+import java.util.Locale;
+import java.util.Objects;
+import java.util.regex.Pattern;
+
+/** Pure JVM policy: no network, files, or native actions are available through this class. */
+final class ReaderDomPolicy {
+  public static final String ORIGIN = "https://appassets.androidplatform.net";
+  public static final String ASSET_PREFIX = "/www.bundle/";
+  private static final Pattern ENTRY_PATH = Pattern.compile("/android_asset/www\\.bundle/[a-f0-9]{32}\\.html");
+  private static final Pattern ENCODED_ESCAPE = Pattern.compile("%(?:2e|2f|5c|00|25)", Pattern.CASE_INSENSITIVE);
+  private final String devOrigin;
+  private URI entry;
+
+  public ReaderDomPolicy(boolean debuggable, String configuredDevOrigin) {
+    if (configuredDevOrigin == null || configuredDevOrigin.isEmpty()) {
+      devOrigin = null;
+      return;
+    }
+    require(debuggable, "Reader development origin is forbidden in release builds.");
+    URI uri = parse(configuredDevOrigin);
+    String normalized = uri == null ? null : origin(uri);
+    require(normalized != null && !ORIGIN.equals(normalized) && uri.getRawQuery() == null &&
+      uri.getRawFragment() == null && ("".equals(uri.getRawPath()) || "/".equals(uri.getRawPath())),
+      "Reader development origin must be one exact HTTP(S) origin.");
+    devOrigin = normalized;
+  }
+
+  public static URI parse(String value) {
+    try { return value == null ? null : new URI(value); }
+    catch (URISyntaxException error) { return null; }
+  }
+
+  public static String origin(URI uri) {
+    if (uri == null || uri.getScheme() == null || uri.getHost() == null || uri.getRawUserInfo() != null) return null;
+    String scheme = uri.getScheme().toLowerCase(Locale.ROOT);
+    String host = uri.getHost().toLowerCase(Locale.ROOT);
+    if (!(scheme.equals("https") || scheme.equals("http")) || host.isEmpty()) return null;
+    int port = uri.getPort();
+    if (port != -1 && (port < 1 || port > 65535)) return null;
+    int defaultPort = scheme.equals("https") ? 443 : 80;
+    return scheme + "://" + host + (port == -1 || port == defaultPort ? "" : ":" + port);
+  }
+
+  public static boolean safePath(URI uri) {
+    if (uri == null || uri.getRawPath() == null || uri.getPath() == null) return false;
+    String path = uri.getPath();
+    if (ENCODED_ESCAPE.matcher(uri.getRawPath()).find() || path.indexOf('\\') >= 0 || hasControl(path)) return false;
+    for (String segment : path.split("/", -1)) if (segment.equals(".") || segment.equals("..")) return false;
+    return true;
+  }
+
+  public URI getEntry() { return entry; }
+
+  public String setEntry(String source) {
+    URI uri = parse(source);
+    require(uri != null, "Invalid reader source.");
+    URI resolved;
+    if ("file".equals(uri.getScheme()) && (uri.getRawAuthority() == null || uri.getRawAuthority().isEmpty()) &&
+      uri.getRawQuery() == null && uri.getRawFragment() == null &&
+      uri.getRawPath() != null && ENTRY_PATH.matcher(uri.getRawPath()).matches()) {
+      resolved = URI.create(ORIGIN + ASSET_PREFIX + uri.getRawPath().substring(uri.getRawPath().lastIndexOf('/') + 1));
+    } else {
+      require(devOrigin != null && devOrigin.equals(origin(uri)) && safePath(uri) &&
+        (uri.getPath().equals("/_expo/@dom") || uri.getPath().startsWith("/_expo/@dom/")),
+        "Reader source must be the packaged DOM entry or the configured development entry.");
+      resolved = uri;
+    }
+    require(entry == null || entry.equals(resolved), "A reader host cannot change its trusted root.");
+    entry = resolved;
+    return resolved.toString();
+  }
+
+  public boolean isEntry(String value) {
+    URI uri = parse(value);
+    return uri != null && entry != null && Objects.equals(origin(uri), origin(entry)) &&
+      Objects.equals(uri.getRawPath(), entry.getRawPath()) && Objects.equals(uri.getRawQuery(), entry.getRawQuery()) && safePath(uri);
+  }
+
+  public boolean acceptsMessage(String sourceOrigin, boolean mainFrame, String currentUrl) {
+    return mainFrame && isEntry(currentUrl) && Objects.equals(origin(parse(sourceOrigin)), origin(entry));
+  }
+
+  public boolean isAssetOrigin(String value) { return ORIGIN.equals(origin(parse(value))); }
+
+  /** Invalid variants of our reserved host are local errors, never DNS fallbacks. */
+  public boolean isAssetHost(String value) {
+    URI uri = parse(value);
+    if (uri == null || uri.getHost() == null) return false;
+    String host = uri.getHost();
+    while (host.endsWith(".")) host = host.substring(0, host.length() - 1);
+    return host.equalsIgnoreCase("appassets.androidplatform.net");
+  }
+
+  /** Maps only APK www.bundle assets; never internal storage, res/, or arbitrary APK assets. */
+  public String assetPath(String value) {
+    URI uri = parse(value);
+    if (!ORIGIN.equals(origin(uri)) || !safePath(uri) || !uri.getPath().startsWith(ASSET_PREFIX)) return null;
+    String relative = uri.getPath().substring(ASSET_PREFIX.length());
+    return relative.isEmpty() || relative.startsWith("/") || relative.endsWith("/") || relative.contains("//") ? null : relative;
+  }
+
+  public boolean isExternal(String value) {
+    URI uri = parse(value);
+    String candidate = origin(uri);
+    return candidate != null && !isAssetHost(value) &&
+      !candidate.equals(devOrigin) && !hasControl(value);
+  }
+
+  private static boolean hasControl(String value) {
+    for (int i = 0; i < value.length(); i++) if (value.charAt(i) < 32 || value.charAt(i) == 127) return true;
+    return false;
+  }
+
+  private static void require(boolean valid, String message) {
+    if (!valid) throw new IllegalArgumentException(message);
+  }
+}
