# Optional public deployment configuration. No Manabi application server is needed.
# Set the canonical origin for static metadata, e.g. https://reader.example.org.
VITE_BASE_PATH=
# Optional public OAuth client IDs registered for this deployment's redirect URIs.
VITE_GDRIVE_CLIENT_ID=
VITE_ONEDRIVE_CLIENT_ID=
# Never put client secrets, API keys or tokens in VITE_* variables.
# Keep VITE_STORAGE_ROOT_NAME unset; renaming it requires a data migration.
