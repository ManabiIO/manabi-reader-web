{
  "name": "@manabi/reader",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/prepare-expo.mjs && expo start --web",
    "build": "node ../../scripts/prepare-expo.mjs && expo export --platform web --output-dir build && node ../../scripts/expo-postbuild.mjs",
    "preview": "node ../../scripts/serve-expo.mjs",
    "check": "tsc --noEmit",
    "check:types": "tsc --noEmit",
    "check:watch": "tsc --noEmit --watch",
    "start": "pnpm prepare:assets && expo start --android",
    "android": "pnpm prepare:assets && expo run:android",
    "export:android": "pnpm prepare:assets && expo export --platform android",
    "prebuild:android": "pnpm prepare:assets && expo prebuild --platform android",
    "prepare:assets": "node ../../scripts/prepare-dictionary.mjs && node ../../scripts/prepare-expo.mjs"
  },
  "devDependencies": {
    "@internationalized/date": "3.12.4",
    "@tailwindcss/aspect-ratio": "0.4.2",
    "@tailwindcss/forms": "0.5.11",
    "@types/balanced-match": "3.0.2",
    "@types/path-browserify": "1.0.3",
    "@types/ua-parser-js": "0.7.39",
    "@types/webappsec-credential-management": "0.6.9",
    "@types/wicg-file-system-access": "2023.10.7",
    "clsx": "2.1.1",
    "postcss": "8.5.28",
    "sass": "1.104.0",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "tslib": "2.8.1",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "~19.2.3",
    "@tailwindcss/postcss": "4.3.3",
    "babel-preset-expo": "~58.0.18",
    "@react-native/metro-config": "0.88.0"
  },
  "dependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-ruby-text": "3.31.3",
    "@tiptap/extension-unique-id": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@zip.js/zip.js": "2.4.26",
    "balanced-match": "3.0.1",
    "dompurify": "3.4.15",
    "fake-indexeddb": "6.2.5",
    "fast-xml-parser": "5.11.1",
    "idb": "8.0.3",
    "mediabunny": "1.59.1",
    "onnxruntime-web": "1.29.0",
    "p-limit": "7.3.2",
    "parse5": "8.0.1",
    "path-browserify": "1.0.1",
    "rxjs": "7.8.2",
    "ua-parser-js": "2.0.10",
    "@expo/metro-runtime": "~58.0.14",
    "@expo/ui": "~58.0.21",
    "expo-router": "~58.0.24",
    "expo-asset": "~58.0.17",
    "expo-constants": "~58.0.12",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-audio": "~58.0.9",
    "expo-keep-awake": "~58.0.3",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "expo-sqlite": "~58.0.13",
    "expo-secure-store": "~58.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "~0.21.4",
    "react-native-screens": "~4.30.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-worklets": "0.13.0",
    "react-native-reanimated": "4.7.1",
    "react-native-webview": "14.0.1",
    "expo": "58.0.16",
    "@phosphor-icons/react": "2.1.10",
    "lucide-react": "1.49.0",
    "@expo/dom-webview": "58.0.2"
  },
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-dom-webview"
        ]
      }
    }
  }
}
