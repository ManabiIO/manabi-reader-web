{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "moduleSuffixes": [".windows", ".native", ""],
    "types": ["react"],
    "paths": { "react-native": ["./node_modules/react-native-windows"] }
  },
  "include": ["src/**/*.tsx", "src/**/*.ts"]
}
